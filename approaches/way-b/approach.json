{
  "name": "way-b",
  "title": "Mounted files and refresh",
  "manifests": ["deploy/way-b-volume"],
  "reset": ["kubectl", "-n", "thesis", "patch", "configmap", "demo-config", "--type", "merge", "-p",
            "{\"data\":{\"demo.configVersion\":\"{initialVersion}\",\"demo.timeoutMs\":\"{initialTimeoutMs}\"}}"],
  "commit": ["kubectl", "-n", "thesis", "patch", "configmap", "demo-config", "--type", "merge", "-p",
             "{\"data\":{\"demo.configVersion\":\"{version}\",\"demo.timeoutMs\":\"{timeoutMs}\"}}"],
  "infrastructure": [
    {"namespace": "platform", "deployment": "config-watcher"}
  ],
  "declared": {
    "extraComponents": ["Spring Cloud Kubernetes Configuration Watcher"],
    "operatorActionsPerChange": 1,
    "clusterWideRbac": true,
    "serviceCoupling": "actuator refresh endpoint, refresh-scoped beans"
  }
}
