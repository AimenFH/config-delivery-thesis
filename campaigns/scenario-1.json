{
  "name": "scenario-1",
  "repetitions": 15,
  "maxAttempts": 20,
  "url": "http://localhost:30080/probe",
  "ratePerSecond": 50,
  "expectedReplicas": 3,
  "maxGapMillis": 1000,
  "ways": [
    {
      "name": "way-a",
      "manifests": "deploy/way-a-envvar",
      "versionKey": "configVersion",
      "warmupSeconds": 5,
      "durationSeconds": 90,
      "settleSeconds": 30,
      "pauseSeconds": 60
    },
    {
      "name": "way-c",
      "manifests": "deploy/way-c-configserver",
      "changeCommand": ["bash", "tools/way-c-change.sh", "{version}"],
      "warmupSeconds": 5,
      "durationSeconds": 30,
      "settleSeconds": 30,
      "pauseSeconds": 30
    },
    {
      "name": "way-b",
      "manifests": "deploy/way-b-volume",
      "versionKey": "demo.configVersion",
      "warmupSeconds": 5,
      "durationSeconds": 150,
      "settleSeconds": 100,
      "pauseSeconds": 30
    }
  ]
}
