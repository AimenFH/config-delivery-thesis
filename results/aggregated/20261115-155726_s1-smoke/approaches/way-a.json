{
  "name" : "way-a",
  "title" : "Environment variables and rolling restart",
  "manifests" : [ "deploy/way-a-envvar" ],
  "reset" : [ "kubectl", "-n", "thesis", "patch", "configmap", "demo-config", "--type", "merge", "-p", "{\"data\":{\"configVersion\":\"{initialVersion}\",\"timeoutMs\":\"{initialTimeoutMs}\"}}" ],
  "commit" : [ "kubectl", "-n", "thesis", "patch", "configmap", "demo-config", "--type", "merge", "-p", "{\"data\":{\"configVersion\":\"{version}\",\"timeoutMs\":\"{timeoutMs}\"}}" ],
  "trigger" : null,
  "sourceCheck" : null,
  "infrastructure" : [ {
    "namespace" : "platform",
    "deployment" : "reloader-reloader"
  } ],
  "declared" : {
    "extraComponents" : [ "Stakater Reloader" ],
    "operatorActionsPerChange" : 1,
    "clusterWideRbac" : true,
    "serviceCoupling" : "none, values read at process start"
  }
}